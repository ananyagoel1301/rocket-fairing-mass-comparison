\centering
\caption{Comparison of baseline and modified fairing designs}\label{tab:fairing_results}
\begin{tabular}{lcc}
\hline
\textbf{Parameter} & \textbf{Baseline} & \textbf{Modified Cubic}\\
\hline
Outer profile & Tangent-ogive & Tangent-ogive\\
Inner profile & $0.9y_o(x)$ & Cubic polynomial\\
Internal volume ($\mathrm{m^3}$) & 0.524807 & 0.584013\\
